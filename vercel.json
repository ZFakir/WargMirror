{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "https://wargmirror.onrender.com/auth/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://wargmirror.onrender.com/api/$1"
    },
    {
      "source": "/",
      "destination": "/client/home.html"
    },
    {
      "source": "/(styles|scripts|assets)/(.*)",
      "destination": "/client/$1/$2"
    },
    {
      "source": "/(.*)",
      "destination": "/client/$1"
    }
  ]
}
