{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(styles|scripts)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "https://wargmirror.onrender.com/auth/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://wargmirror.onrender.com/api/$1"
    },
    {
      "source": "/",
      "destination": "/client/home.html"
    },
    {
      "source": "/(styles|scripts|assets)/(.*)",
      "destination": "/client/$1/$2"
    },
    {
      "source": "/(.*)",
      "destination": "/client/$1"
    }
  ]
}
