# ─────────────────────────────────────────────────────────────
#  WARG Platform — backend environment
#  Copy to .env and fill in real values:  cp .env.example .env
#  Never commit the real .env (it is gitignored).
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# MySQL connection URI.
#   Local:  mysql://user:password@localhost:3306/warg
#   Aiven:  mysql://avnadmin:password@host.aivencloud.com:port/defaultdb?ssl-mode=REQUIRED
DATABASE_URL=mysql://user:password@localhost:3306/warg

# Sessions. REQUIRED in production — the app refuses to start without it.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# CORS + OAuth redirect allowlist.
# Comma-separated list of every frontend origin that calls the API
# (local dev server + your Vercel deployment).
CLIENT_URL=http://localhost:8080,https://your-app.vercel.app
# Frontend origin whose /client path serves the HTML pages; used to build
# post-login redirect targets. Set to your Vercel URL in production.
CLIENT_PAGES_URL=http://localhost:8080

# Google OAuth — optional. Without these, /auth/google is not registered
# and only email/password login is available.
# GOOGLE_CALLBACK_URL may be left as the relative default below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/auth/google/callback

# AI Engine (Python/FastAPI microservice) — optional for local development.
AI_SERVICE_URL=http://localhost:8000
# Dev fallback keys; both must be set to real shared secrets in production
# (AI_KEY is hard-required there — the server refuses to start without it).
AI_KEY=dev-secret-key
AI_API_KEY=dev-secret-key
