{
  "name": "warg-platform-backend",
  "version": "1.0.0",
  "description": "Backend server for WARG Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed.js",
    "lint": "eslint .",
    "test:unit": "cross-env NODE_ENV=test jest --selectProjects unit",
    "test:integration": "cross-env NODE_ENV=test jest --selectProjects integration --runInBand",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "mysql2": "^3.10.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "sequelize": "^6.37.3",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jest": "^30.5.1",
    "supertest": "^7.2.2"
  }
}
